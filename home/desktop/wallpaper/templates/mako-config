# Layout
width=400
height=150
margin=20
padding=15
border-size=2
border-radius=10

# Icons
icons=true
max-icon-size=64
icon-path=@papirusIconPath@

# Behavior
default-timeout=5000
ignore-timeout=true

# Font
font=FiraCode Nerd Font 11

# Positioning
anchor=top-right

# Colors — bg/text locked to Vicinae orchis-dark, border is wallpaper accent
background-color=#1a1a1a
text-color=#fff3e0
border-color={{colors.primary.default.hex}}
progress-color=over #2a2a2a

[urgency=low]
border-color={{colors.primary.default.hex}}
default-timeout=3000

[urgency=normal]
border-color={{colors.primary.default.hex}}
default-timeout=5000

[urgency=high]
border-color={{colors.error.default.hex}}
text-color={{colors.error.default.hex}}
default-timeout=0
