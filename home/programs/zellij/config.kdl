// Locked by default: every key reaches the app in the pane except the Alt chords below.
// No modes, no Ctrl chords (they collided with Claude Code, helix and nushell).
// Quit and rename go through `zellij action`; scrollback via the mouse wheel.
keybinds clear-defaults=true {
    locked {
        // Focus
        bind "Alt left" { MoveFocusOrTab "left"; }
        bind "Alt down" { MoveFocus "down"; }
        bind "Alt up" { MoveFocus "up"; }
        bind "Alt right" { MoveFocusOrTab "right"; }
        bind "Alt h" { MoveFocusOrTab "left"; }
        bind "Alt j" { MoveFocus "down"; }
        bind "Alt k" { MoveFocus "up"; }
        bind "Alt l" { MoveFocusOrTab "right"; }
        // Workspace tabs (the overbridge sidebar numbers them in tab order)
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt ," { GoToPreviousTab; }
        bind "Alt ." { GoToNextTab; }
        bind "Alt i" { MoveTab "left"; }
        bind "Alt o" { MoveTab "right"; }
        // Panes
        bind "Alt n" { NewPane; }
        bind "Alt x" { CloseFocus; }
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt +" { Resize "Increase"; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        // Session
        bind "Alt d" { Detach; }
        // Next workspace that needs you: waiting for input, then finished, then finished with background tasks
        bind "Alt w" {
            Run "overbridge" "next" {
                floating true
                close_on_exit true
                x "100%"
                y "100%"
                width 1
                height 1
            }
        }
    }
}

plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
}

scrollback_editor "hx"
copy_command "wl-copy"
// Shift+drag for native terminal selection
mouse_mode true

default_mode "locked"

theme "darcula"

themes {
    darcula {
        fg "#a9b7c6"
        bg "#2b2b2b"
        black "#181818"
        red "#a34a27"
        green "#629755"
        yellow "#cc7832"
        blue "#6897bb"
        magenta "#9876aa"
        cyan "#6897bb"
        white "#d0d0d0"
        orange "#ff8800"
    }
}

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

pane_frames false
